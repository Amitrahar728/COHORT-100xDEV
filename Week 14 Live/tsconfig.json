{
  "compilerOptions": {
    "module": "commonjs",
    "target": "esnext",

    "rootDir": "./src",
    "outDir": "./dist",

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,

    "jsx": "react-jsx",

    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,

    "skipLibCheck": true
  },

  "include": ["src"]
}